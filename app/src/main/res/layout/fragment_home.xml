<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentHome">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/home_toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.appcompat.widget.Toolbar>

    <ImageView
        android:id="@+id/home_line1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_toolbar" />

    <ScrollView
        android:id="@+id/home_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/home_image_find_mate"
                android:layout_width="340dp"
                android:layout_height="180dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/radius_5_transparent"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@color/gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_btn_go_mate" />

            <ImageView
                android:id="@+id/home_image_save_walk_record"
                android:layout_width="340dp"
                android:layout_height="180dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/radius_10_solid_yellow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.49"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_btn_go_walk" />

            <ImageView
                android:id="@+id/home_view_popular_post1"
                android:layout_width="340dp"
                android:layout_height="120dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/radius_10_stroke_gray"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_btn_go_community" />

            <ImageView
                android:id="@+id/home_view_popular_post2"
                android:layout_width="340dp"
                android:layout_height="120dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/radius_10_stroke_gray"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_view_popular_post1" />

            <RelativeLayout
                android:id="@+id/home_relative_layout"
                android:layout_width="340dp"
                android:layout_height="170dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_btn_go_deal" />

            <Button
                android:id="@+id/home_btn_go_walk"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:drawableRight="@drawable/svg_chevron_right"
                android:text="산책 기록하기"
                app:layout_constraintStart_toStartOf="@+id/home_btn_go_mate"
                app:layout_constraintTop_toBottomOf="@+id/home_image_find_mate" />

            <Button
                android:id="@+id/home_btn_go_mate"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:drawableRight="@drawable/svg_chevron_right"
                android:text="산책메이트 찾으러 가기"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/home_btn_go_community"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:background="@android:color/transparent"
                android:drawableRight="@drawable/svg_chevron_right"
                android:text="인기 게시글"
                app:layout_constraintStart_toStartOf="@+id/home_btn_go_walk"
                app:layout_constraintTop_toBottomOf="@+id/home_image_save_walk_record" />

            <Button
                android:id="@+id/home_btn_go_deal"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@android:color/transparent"
                android:drawableRight="@drawable/svg_chevron_right"
                android:gravity="start|center"
                android:text="물품 거래"
                app:layout_constraintStart_toStartOf="@+id/home_btn_go_community"
                app:layout_constraintTop_toBottomOf="@+id/home_view_popular_post2" />

            <TextView
                android:id="@+id/home_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="오늘의 기록"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/home_image_save_walk_record"
                app:layout_constraintTop_toTopOf="@+id/home_image_save_walk_record" />

            <ImageButton
                android:id="@+id/home_btn_go_calendar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/svg_calendar2"
                app:layout_constraintEnd_toEndOf="@+id/home_image_save_walk_record"
                app:layout_constraintTop_toTopOf="@+id/home_image_save_walk_record" />

            <TextView
                android:id="@+id/home_text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="산책 시간"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/home_image_save_walk_record"
                app:layout_constraintStart_toStartOf="@+id/home_image_save_walk_record"
                app:layout_constraintTop_toBottomOf="@+id/home_text1" />

            <TextView
                android:id="@+id/home_text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00 : 00 : 00"
                android:textColor="@color/white"
                android:textSize="48sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/home_image_save_walk_record"
                app:layout_constraintStart_toStartOf="@+id/home_image_save_walk_record"
                app:layout_constraintTop_toBottomOf="@+id/home_text2" />

            <TextView
                android:id="@+id/home_text3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="5dp"
                android:text="총"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/home_text_distance"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/home_image_save_walk_record"
                app:layout_constraintTop_toBottomOf="@+id/home_text_time" />

            <TextView
                android:id="@+id/home_text_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="-5dp"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="30sp"
                app:layout_constraintBottom_toBottomOf="@+id/home_text3"
                app:layout_constraintEnd_toStartOf="@+id/home_text4"
                app:layout_constraintStart_toEndOf="@+id/home_text3" />

            <TextView
                android:id="@+id/home_text4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="km 걸었습니다."
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@+id/home_text_distance"
                app:layout_constraintEnd_toEndOf="@+id/home_image_save_walk_record"
                app:layout_constraintStart_toEndOf="@+id/home_text_distance" />

            <TextView
                android:id="@+id/home_post_title1"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text=""
                android:textStyle="bold"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_view_popular_post1"
                app:layout_constraintTop_toTopOf="@id/home_view_popular_post1" />

            <TextView
                android:id="@+id/home_post_body1"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text=""
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_post_title1"
                app:layout_constraintTop_toBottomOf="@id/home_post_title1" />

            <TextView
                android:id="@+id/home_post_time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text=""
                android:textColor="@color/hint"
                android:textSize="11sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/home_view_popular_post1"
                app:layout_constraintStart_toStartOf="@id/home_post_body1" />

            <ImageView
                android:id="@+id/home_post_img1"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/radius_5_transparent"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/svg_camera"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/home_view_popular_post1"
                app:layout_constraintTop_toTopOf="@id/home_view_popular_post1" />

            <TextView
                android:id="@+id/home_post_title2"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:text=""
                android:textStyle="bold"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_view_popular_post2"
                app:layout_constraintTop_toTopOf="@id/home_view_popular_post2" />

            <TextView
                android:id="@+id/home_post_body2"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text=""
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_post_title2"
                app:layout_constraintTop_toBottomOf="@id/home_post_title2" />

            <TextView
                android:id="@+id/home_post_time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text=""
                android:textColor="@color/hint"
                android:textSize="11sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/home_view_popular_post2"
                app:layout_constraintStart_toStartOf="@id/home_post_body2" />

            <ImageView
                android:id="@+id/home_post_img2"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/radius_5_transparent"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/svg_camera"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/home_view_popular_post2"
                app:layout_constraintTop_toTopOf="@id/home_view_popular_post2" />

            <ImageView
                android:id="@+id/home_deal_img1"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/radius_5_transparent"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/svg_camera"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_relative_layout"
                app:layout_constraintTop_toTopOf="@id/home_relative_layout" />

            <TextView
                android:id="@+id/home_deal_title1"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_img1"
                app:layout_constraintTop_toBottomOf="@id/home_deal_img1" />

            <TextView
                android:id="@+id/home_deal_price1"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textSize="12sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_title1"
                app:layout_constraintTop_toBottomOf="@id/home_deal_title1" />

            <TextView
                android:id="@+id/home_deal_date1"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textColor="@color/hint"
                android:textSize="11sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_price1"
                app:layout_constraintTop_toBottomOf="@id/home_deal_price1" />

            <ImageView
                android:id="@+id/home_deal_img2"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/radius_5_transparent"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/svg_camera"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/home_deal_img1"
                app:layout_constraintTop_toTopOf="@id/home_deal_img1" />

            <TextView
                android:id="@+id/home_deal_title2"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_img2"
                app:layout_constraintTop_toBottomOf="@id/home_deal_img2" />

            <TextView
                android:id="@+id/home_deal_price2"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textSize="12sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_title2"
                app:layout_constraintTop_toBottomOf="@id/home_deal_title2" />

            <TextView
                android:id="@+id/home_deal_date2"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textColor="@color/hint"
                android:textSize="11sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_price2"
                app:layout_constraintTop_toBottomOf="@id/home_deal_price2" />

            <ImageView
                android:id="@+id/home_deal_img3"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/radius_5_transparent"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/svg_camera"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/home_deal_img2"
                app:layout_constraintTop_toTopOf="@id/home_deal_img2" />

            <TextView
                android:id="@+id/home_deal_title3"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_img3"
                app:layout_constraintTop_toBottomOf="@id/home_deal_img3" />

            <TextView
                android:id="@+id/home_deal_price3"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textSize="12sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_title3"
                app:layout_constraintTop_toBottomOf="@id/home_deal_title3" />

            <TextView
                android:id="@+id/home_deal_date3"
                android:layout_width="70dp"
                android:layout_height="20dp"
                android:text=""
                android:textColor="@color/hint"
                android:textSize="11sp"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/home_deal_price3"
                app:layout_constraintTop_toBottomOf="@id/home_deal_price3" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:src="@drawable/petstory25"
        app:layout_constraintBottom_toBottomOf="@+id/home_toolbar"
        app:layout_constraintStart_toStartOf="@+id/home_toolbar"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>